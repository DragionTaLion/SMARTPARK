class ResidentCreate(BaseModel):
    bien_so_xe: str
    ten_chu_xe: str
    so_can_ho: str = ""


@app.post("/api/residents", tags=["Residents"])
async def add_resident(body: ResidentCreate):
    try:
        from services.database_service import add_resident as db_add
        return db_add(body.bien_so_xe, body.ten_chu_xe, body.so_can_ho)
    except ValueError as e:
        raise HTTPException(status_code=409, detail=str(e))
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"DB error: {e}")


@app.delete("/api/residents/{resident_id}", tags=["Residents"])
async def delete_resident(resident_id: int):
    try:
        from services.database_service import remove_resident
        name = remove_resident(resident_id)
        return {"success": True, "message": f"Đã xóa: {name}"}
    except ValueError as e:
        raise HTTPException(status_code=404, detail=str(e))
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"DB error: {e}")


# Legacy IoT trigger endpoint (tương thích firmware cũ và nút bấm UI)
@app.post("/api/iot/trigger", tags=["IoT", "Legacy"])
async def iot_trigger_legacy(request):
    """Chuyển tiếp tới V1 entry-request để tương thích ngược."""
    from api.v1.router import entry_request
    from models.schemas import EntryRequest
    try:
        body_raw = await request.body()
        if body_raw:
            import json
            data = json.loads(body_raw)
            req_body = EntryRequest(**data)
        else:
            req_body = EntryRequest()
    except Exception:
        req_body = EntryRequest()
    return await entry_request(req_body, request)


@app.get("/api/video_feed", tags=["System"])
async def video_feed():
    """MJPEG proxy stream từ ESP32-CAM tới frontend."""
    def _gen():
        while True:
            if state.latest_frame is not None and state.camera_connected:
                _, jpeg = cv2.imencode('.jpg', state.latest_frame, [cv2.IMWRITE_JPEG_QUALITY, 80])
                frame_bytes = jpeg.tobytes()
            else:
                # Tạo ảnh đen "Camera Offline" khi không có kết nối
                placeholder = np.zeros((480, 640, 3), dtype=np.uint8)
                cv2.putText(placeholder, "CAMERA OFFLINE", (160, 240), 
                            cv2.FONT_HERSHEY_SIMPLEX, 1, (0, 0, 255), 2)
                cv2.putText(placeholder, f"Retrying connection to {state.camera_ip}...", (120, 280), 
                            cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 255), 1)
                _, buffer = cv2.imencode('.jpg', placeholder)
                frame_bytes = buffer.tobytes()

            yield (b'--frame\r\nContent-Type: image/jpeg\r\n\r\n' + frame_bytes + b'\r\n')
            time.sleep(0.05)  # ~20fps proxy

    return StreamingResponse(_gen(), media_type="multipart/x-mixed-replace; boundary=frame")


@app.post("/api/config/camera_ip", tags=["Config"])
async def set_camera_ip(body: dict):
    state.camera_ip = body.get("ip", state.camera_ip)
    logger.info(f"[CONFIG] camera_ip → {state.camera_ip}")
    return {"success": True, "camera_ip": state.camera_ip}


@app.post("/api/config/esp8266_ip", tags=["Config"])
async def set_esp8266_ip(body: dict):
    state.esp8266_ip = body.get("ip", state.esp8266_ip)
    logger.info(f"[CONFIG] esp8266_ip → {state.esp8266_ip}")
    return {"success": True, "esp8266_ip": state.esp8266_ip}


# ─── WebSocket Live ───────────────────────────────────────────────────────────

@app.websocket("/ws/live")
async def websocket_live(websocket: WebSocket):
    await ws_manager.connect(websocket)
    try:
        while True:
            await asyncio.sleep(15)
            await websocket.send_json({"type": "ping", "ts": time.time()})
    except WebSocketDisconnect:
        pass
    except Exception:
        pass
    finally:
        ws_manager.disconnect(websocket)


# ─── Entrypoint ───────────────────────────────────────────────────────────────

if __name__ == "__main__":
    import uvicorn
    uvicorn.run("api_server:app", host="0.0.0.0", port=8000, reload=False, log_level="info")
