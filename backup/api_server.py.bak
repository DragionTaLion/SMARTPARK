"""
api_server.py — SmartPark ALPR Backend v3.0
==========================================
Kiến trúc phân lớp: Controller → Service → Model → Hardware

Endpoints:
  V1:
    POST /api/v1/entry-request  — ESP8266 trigger (IoT Core)
  Legacy (giữ tương thích):
    GET  /api/health            — System health
    GET  /api/stats             — Statistics
    GET  /api/logs              — History
    GET  /api/residents         — Residents list
    POST /api/residents         — Add resident
    DELETE /api/residents/{id}  — Delete resident
    GET  /api/video_feed        — MJPEG proxy stream
    WS   /ws/live               — Real-time WebSocket

GPU: Auto CUDA (RTX 3060), fallback CPU.
"""

import asyncio
import io
import logging
import os
import sys
import time
import threading
import traceback
from contextlib import asynccontextmanager
from typing import Any, List, Optional

import cv2
import numpy as np
from fastapi import FastAPI, WebSocket, WebSocketDisconnect, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import JSONResponse, StreamingResponse
from pydantic import BaseModel

# ─── Logging Setup ────────────────────────────────────────────────────────────

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [%(name)s] %(levelname)s: %(message)s",
    handlers=[logging.StreamHandler(sys.stdout)],
)
logger = logging.getLogger("api_server")

# Fix encoding Windows
if sys.stdout.encoding and sys.stdout.encoding.lower() != "utf-8":
    try:
        sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8")
    except Exception:
        pass


# ─── App State ────────────────────────────────────────────────────────────────

class SmartParkState:
    """State toàn cục của hệ thống SmartPark."""
    
    # AI Models
    yolo_model = None
    char_model = None
    easyocr_reader = None
    use_cuda: bool = False

    # Camera Source
    camera_ip: str = "0"         # "0" = Laptop Cam, "192.168.x.x" = ESP32-CAM
    latest_frame: Optional[np.ndarray] = None
    camera_connected: bool = False
    esp32_running: bool = False

    # ESP8266
    esp8266_ip: str = "192.168.137.241"
    usb_mode: bool = False       # False = WiFi, True = USB Serial

    # USB Serial (fallback)
    ser: Optional[Any] = None
    serial_port: str = "COM3"

    # WebSocket Clients
    active_connections: List[WebSocket] = []

    # Detection State
    plate_cooldown: dict = {}    # {plate: {"ts": float}}
    plate_status: dict = {}      # {plate: "Vao"/"Ra"}

    # Processing lock
    iot_processing: bool = False

    # Event loop (để broadcast WS an toàn từ thread)
    event_loop = None


state = SmartParkState()


# ─── Camera Worker Thread ─────────────────────────────────────────────────────

def camera_worker():
    """Worker thread: Liên tục kết nối và capture frame từ ESP32-CAM hoặc Local Cam."""
    logger.info(f"[CAM-WORKER] Bắt đầu khởi động (Nguồn: {state.camera_ip})")
    state.esp32_running = True
    
    while state.esp32_running:
        source = state.camera_ip
        is_local = source.isdigit()
        
        if is_local:
            idx = int(source)
            logger.info(f"[CAM-WORKER] 🔌 Đang kết nối Camera Local: {idx}")
            cap = cv2.VideoCapture(idx)
        else:
            stream_url = f"http://{source}:81/stream"
            logger.info(f"[CAM-WORKER] 🌐 Đang kết nối Cam IP: {stream_url}")
            cap = cv2.VideoCapture(stream_url)
            cap.set(cv2.CAP_PROP_BUFFERSIZE, 1)
        
        if not cap.isOpened():
            state.camera_connected = False
            logger.warning(f"[CAM-WORKER] ❌ Không thể mở nguồn: {source}. Thử lại sau 5s...")
            cap.release()
            time.sleep(5)
            continue

        state.camera_connected = True
        logger.info(f"[CAM-WORKER] ✅ Camera đã sẵn sàng: {source}")
        
        try:
            while state.esp32_running:
                # Kiểm tra xem nguồn cam có bị thay đổi từ UI không
                if state.camera_ip != source:
                    logger.info(f"[CAM-WORKER] Đổi nguồn camera: {source} -> {state.camera_ip}")
                    break
                
                ret, frame = cap.read()
                if not ret or frame is None:
                    logger.warning(f"[CAM-WORKER] ⚠️ Mất tín hiệu từ {source}")
                    break
                
                state.latest_frame = frame
                state.camera_connected = True
                
                # Nếu là local cam có thể capture nhanh, thêm sleep nhỏ để giảm tải CPU
                time.sleep(0.01)
        except Exception as e:
            logger.error(f"[CAM-WORKER] Lỗi trong lúc capture: {e}")
        finally:
            state.camera_connected = False
            cap.release()
            if state.esp32_running:
                logger.info("[CAM-WORKER] Đang chuẩn bị thử lại sau 5s...")
                time.sleep(5)


# ─── Auto-Detect Worker Thread ────────────────────────────────────────────────

def detect_worker():
    """
    Background thread: tự động nhận diện biển số từ frame buffer mỗi 200ms.
    Chạy song song với IoT trigger, không block main thread.
    """
    logger.info("[DETECT-WORKER] Bắt đầu tự động nhận diện (200ms interval)...")

    while state.esp32_running:
        try:
            if state.latest_frame is None or state.yolo_model is None:
                time.sleep(0.5)
                continue

            if state.iot_processing:
                time.sleep(0.2)
                continue

            import cv2, base64, difflib
            from services import alpr_service, database_service

            frame = state.latest_frame.copy()
            plate_text, bbox, confidence, plate_img_b64 = alpr_service.run_detection_pipeline(
                frame, state.yolo_model, state.char_model, state.easyocr_reader
            )

            if not plate_text or len(plate_text) < 4:
                time.sleep(0.2)
                continue

            # Cooldown 10 giây cho auto-detect (không spam)
            now = time.time()
            if now - state.plate_cooldown.get(plate_text, {}).get("ts", 0) < 10.0:
                time.sleep(0.2)
                continue
            state.plate_cooldown[plate_text] = {"ts": now}

            # DB Lookup
            resident = database_service.find_resident_exact(plate_text)
            if not resident:
                res, matched, ratio = database_service.find_resident_fuzzy(plate_text)
                if res:
                    resident = res

            prev = state.plate_status.get(plate_text, "Ra")
            trang_thai = "Vao" if prev == "Ra" else "Ra"
            state.plate_status[plate_text] = trang_thai

            if resident:
                # Chỉ xử lý và thông báo nếu là cư dân
                database_service.insert_history(plate_text, trang_thai, plate_img_b64)
                
                result = alpr_service.build_detection_result(
                    plate_text, bbox, confidence, plate_img_b64,
                    resident, plate_text, trang_thai, False,
                    False,  # barrier_opened=False — auto-detect không mở servo
                    0
                )

                # broadcast thread-safe
                ws_manager.broadcast_threadsafe(result.model_dump())
                logger.info(f"[DETECT-WORKER] ✅ Cư dân: {plate_text} ({trang_thai})")
            else:
                # Xe lạ: Chỉ log nhẹ ở terminal, không báo lên Web/DB
                logger.info(f"[DETECT-WORKER] ℹ️ Xe lạ: {plate_text} — Bỏ qua (Silent Mode)")

        except Exception as e:
            logger.error(f"[DETECT-WORKER] Lỗi: {e}")
        
        time.sleep(0.2)  # 5 FPS detection rate


from core.websocket import ws_manager


def broadcast_from_thread(data: dict):
    """Thread-safe: gửi data lên WS từ background thread (Legacy wrapper)."""
    ws_manager.broadcast_threadsafe(data)


# ─── Lifespan ─────────────────────────────────────────────────────────────────

@asynccontextmanager
async def lifespan(app: FastAPI):
    print("\n" + "=" * 65)
    print("  SMARTPARK ALPR v3.0 — Full-stack AI & IoT System")
    print("=" * 65)

    # Kiểm tra GPU
    try:
        import torch
        state.use_cuda = torch.cuda.is_available()
        if state.use_cuda:
            gpu_name = torch.cuda.get_device_name(0)
            print(f"  ✅ GPU: {gpu_name}")
        else:
            print("  ⚠️  GPU không khả dụng — chạy CPU")
    except ImportError:
        print("  ⚠️  PyTorch không tìm thấy")

    # Load YOLO
    MODEL_PATH = "runs/detect/HeThongBarrier/Plate_Detection_v12/weights/best.pt"
    print(f"\n  [1/3] YOLO Model: {MODEL_PATH}")
    if os.path.exists(MODEL_PATH):
        try:
            from ultralytics import YOLO
            state.yolo_model = YOLO(MODEL_PATH)
            state.yolo_model.to("cuda" if state.use_cuda else "cpu")
            print(f"  ✅ YOLO loaded (device={'cuda' if state.use_cuda else 'cpu'})")
        except Exception as e:
            logger.error(f"YOLO load error: {e}")

    # Load CNN Char Model
    CHAR_PATH = "runs/classify/data/models/char_model/weights/best.pt"
    print(f"\n  [2/3] CNN Char Model (56 layers): {CHAR_PATH}")
    if os.path.exists(CHAR_PATH):
        try:
            from core.char_recognizer import load_char_model
            state.char_model = load_char_model(CHAR_PATH)
            print("  ✅ CNN Char Model loaded")
        except Exception as e:
            logger.warning(f"CNN load error: {e} — EasyOCR fallback")

    # Load EasyOCR
    print("\n  [3/3] EasyOCR (fallback)...")
    try:
        from core.ocr import init_easyocr
        state.easyocr_reader = init_easyocr()
        print("  ✅ EasyOCR ready")
    except Exception as e:
        logger.error(f"EasyOCR load error: {e}")

    # Expose state to app
    app.state.smartpark = state

    print(f"\n  ✅ Server sẵn sàng tại http://localhost:8000")
    print(f"  📋 Swagger UI: http://localhost:8000/docs")
    print(f"  📡 ESP32-CAM: {state.camera_ip}")
    print(f"  📡 ESP8266:   {state.esp8266_ip}")
    print(f"  🔧 Mode: {'WiFi' if not state.usb_mode else 'USB Serial'}\n")

    # Lưu event loop cho WebSocket manager
    loop = asyncio.get_event_loop()
    state.event_loop = loop
    ws_manager.set_loop(loop)

    # Start background workers
    threading.Thread(target=camera_worker, daemon=True, name="CameraWorker").start()
    threading.Thread(target=detect_worker, daemon=True, name="DetectWorker").start()
    logger.info("Background workers started")

    yield

    state.esp32_running = False
    if state.ser and getattr(state.ser, 'is_open', False):
        state.ser.close()
    print("\n  👋 Server shutting down...")


# ─── FastAPI App ──────────────────────────────────────────────────────────────

app = FastAPI(
    title="SmartPark ALPR API",
    description="Hệ thống nhận diện biển số xe thông minh — v3.0 Modular",
    version="3.0.0",
    lifespan=lifespan,
)

app.add_middleware(
    CORSMiddleware,
    allow_origins=["http://localhost:3000", "http://127.0.0.1:3000", "*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# Mount V1 Router
from api.v1.router import router as v1_router
app.include_router(v1_router)


# ─── Legacy Endpoints (giữ tương thích với velorah-command-center) ─────────────

@app.get("/api/health", tags=["System"])
async def health():
    from services.database_service import check_connection
    db_ok, db_err = check_connection()
    return {
        "status": "ok",
        "db": "connected" if db_ok else f"error: {db_err}",
        "yolo": "loaded" if state.yolo_model else "not loaded",
        "char_model": "loaded" if state.char_model else "not loaded",
        "ocr": "loaded" if state.easyocr_reader else "not loaded",
        "gpu": state.use_cuda,
        "camera_ip": state.camera_ip,
        "esp8266_ip": state.esp8266_ip,
        "usb_mode": state.usb_mode,
        "camera_connected": state.camera_connected,
        "iot_processing": state.iot_processing,
    }


@app.get("/api/stats", tags=["Stats"])
async def get_stats():
    try:
        from services.database_service import get_stats
        return get_stats()
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"DB error: {e}")


@app.get("/api/logs", tags=["Logs"])
async def get_logs(limit: int = 50, status: str = "all", date: str = "all"):
    try:
        from services.database_service import get_history
        return get_history(limit, status, date)
    except Exception as e:
